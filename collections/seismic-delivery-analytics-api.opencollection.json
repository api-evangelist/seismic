{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seismic Analytics Content Analytics Delivery Analytics API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Delivery Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Delivery Analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seismic.com/integration/v2/analytics/deliveries",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "query",
                "description": "Filter deliveries by sender user ID."
              },
              {
                "name": "contentId",
                "value": "",
                "type": "query",
                "description": "Filter deliveries by content item."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date for the analytics period."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date for the analytics period."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              }
            ]
          },
          "docs": "Retrieves analytics data on content deliveries to buyers, including open rates, view durations, and engagement scores."
        }
      ]
    }
  ],
  "bundled": true
}
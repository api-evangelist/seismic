{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seismic Analytics Content Analytics Generation Jobs API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Generation Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Generation Jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seismic.com/integration/v2/livedocs/jobs",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter jobs by status."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              }
            ]
          },
          "docs": "Retrieves a list of asynchronous LiveDoc generation jobs and their statuses."
        },
        {
          "info": {
            "name": "Get a Generation Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seismic.com/integration/v2/livedocs/jobs/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the generation job."
              }
            ]
          },
          "docs": "Retrieves the status and result of a specific generation job."
        }
      ]
    }
  ],
  "bundled": true
}